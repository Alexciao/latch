<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Latch</AssemblyName>
    <RootNamespace>Latch.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Latch.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- A tray app: no background GC thread, smaller heaps. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <PropertyGroup>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- The WinRT projection is huge when precompiled and only Hello/PackageManager use it, off the hot path. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="WinRT.Runtime.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Latch.Core\Latch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Latch.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Inter for the native surfaces (cover title bar, notification card): static instances of the variable font
         the UI bundles, since WPF can't pick variable-font axes. -->
    <Content Include="Fonts\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The built UI (pnpm build in web/) is served from wwwroot through a private virtual host. -->
    <Content Include="..\..\web\dist\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
