root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,json,css,html,md,yml}]
indent_size = 2

[*.cs]
# Noise for a small desktop app; each line says why it is off.
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates: no ILogger here
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait: WPF host relies on the sync context
dotnet_diagnostic.CA1031.severity = none   # catch-all is deliberate at the API wrapper and OS seams
dotnet_diagnostic.CA1303.severity = none   # localization: copy lives in copy.json
dotnet_diagnostic.CA1305.severity = none   # culture: wire formats are invariant by construction
dotnet_diagnostic.CA1062.severity = none   # nullable reference types cover this
dotnet_diagnostic.CA1716.severity = none   # identifiers like `Shared` are fine here
dotnet_diagnostic.CA1515.severity = none   # public types in an exe are fine
dotnet_diagnostic.CA1819.severity = none   # byte[] properties on records are fine
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1002.severity = none   # List<T> in records is fine
dotnet_diagnostic.CA1024.severity = none
dotnet_diagnostic.CA1707.severity = none   # test names use underscores
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1823.severity = none
dotnet_diagnostic.CA1308.severity = none   # lower-case normalization is intended
dotnet_diagnostic.CA1806.severity = none   # Win32 BOOL results are often ignored on purpose
dotnet_diagnostic.CA1069.severity = none
dotnet_diagnostic.CA1008.severity = none
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1051.severity = none   # interop structs expose fields
dotnet_diagnostic.CA1401.severity = none
dotnet_diagnostic.CA1416.severity = none   # host is Windows-only by TFM
dotnet_diagnostic.CA5392.severity = none
dotnet_diagnostic.CA1060.severity = none
dotnet_diagnostic.CA2101.severity = none
dotnet_diagnostic.SYSLIB1054.severity = none # DllImport kept for COM-heavy shell interop
